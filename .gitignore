# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE / Editor
.vscode/
.idea/
.gemini/

# Digital Library Media (Ignore heavy files to prevent Git repo bloat)
# Note: Remove these if you want to commit all your PDFs/Videos to Git.
/public/pdfs/*
!/public/pdfs/sample.pdf
/public/books/pdf/*
!/public/books/pdf/sample.pdf
/public/audios/*
!/public/audios/sample.mp3
/public/videos/*
